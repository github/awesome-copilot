# =====================================================================
# ATENCION: TODO lo que empieza con VITE_ es PUBLICO.
# Vite lo incrusta en el bundle JS y cualquiera lo lee con "Ver codigo
# fuente". No pongas aca nada que sea realmente secreto.
#  - La URL del trigger HTTP del flow NO es secreta (lleva una firma `sig`,
#    pero viaja en el bundle): quien la vea puede llamar al flow.
#  - VITE_APP_KEY es solo un "reductor de velocidad" anti-bot, no una
#    credencial. Ver skill spa-sharepoint-power-automate §1 y §9 (Check_key).
# Copia este archivo a .env.local (esta en .gitignore) y completalo.
# =====================================================================

# URL del trigger "When a HTTP request is received" (Who can trigger = Anyone).
# Vacia = MODO DEMO: el formulario funciona pero no envia nada.
VITE_POWER_AUTOMATE_URL=

# Valor esperado por la condicion Check_key del flow (cabecera x-app-key).
VITE_APP_KEY=

# Base path. Por defecto './' (relativo, sirve en GitHub Pages bajo /<repo>/).
# Solo cambialo si necesitas una ruta absoluta, ej: /mi-repo/
VITE_BASE=./
