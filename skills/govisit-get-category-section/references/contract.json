          "contentVersion",
          "updatedAt"
        ],
        "additionalProperties": false
      },
      "completeness": {
        "const": "page-published-section"
      },
      "data": {
        "description": "The requested published section. Overview is an object; lists are arrays of at most 20 items; places/experiences may wrap items in an object; missing opening-hours data is null. Strings and nested lists are bounded by the WebMCP snapshot policy.",
        "type": [
          "object",
          "array",
          "string",
          "null"
        ],
        "maxItems": 20,
        "items": {
          "description": "Published JSON value; optional field shapes depend on the page projection."
        },
        "anyOf": [
          {
            "title": "Overview (section=overview)",
            "type": "object",
            "properties": {
              "destinationCode": {
                "type": "string"
              },
              "destinationName": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "count": {
                "type": "number"
              },
              "isOther": {
                "type": "boolean"
              },
              "parentCode": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "destinationCode",
              "destinationName",
              "code",
              "label"
            ],
            "additionalProperties": false
          },
          {
            "title": "Published list section",
            "type": "array",
            "maxItems": 20,
            "items": {
              "description": "Published section records; fields depend on the section and the page projection."
            }
          },
          {
            "title": "Published structured section",
            "type": "object",
            "description": "Named public fields or an items list, such as places.items, location coordinates, opening hours or experience groups.",
            "properties": {
              "items": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "object"
                }
              }
            }
          },
          {
            "title": "Published text section",
            "type": "string",
            "maxLength": 4000
          },
          {
            "title": "Unavailable published section",
            "type": "null"
          }
        ]
      }
    },
