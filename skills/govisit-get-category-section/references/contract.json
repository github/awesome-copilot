        "maxLength": 1000,
        "description": "Canonical GoVisit page path supplying this tool's published context; no origin, query or fragment."
      },
      "section": {
        "type": "string",
        "enum": [
          "overview",
          "places"
        ]
      }
    },
    "required": [
      "pagePath",
      "section"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "description": "Successful read of the sanitized published page snapshot. Unsupported sections reject the invocation.",
    "properties": {
      "schemaVersion": {
        "const": "1"
      },
      "pageType": {
        "const": "category"
      },
      "pageId": {
        "type": "string"
      },
      "locale": {
        "type": "string"
      },
      "canonicalUrl": {
        "type": "string"
      },
      "contentVersion": {
        "type": [
          "string",
          "number",
          "null"
        ]
      },
      "updatedAt": {
        "type": [
          "string",
          "null"
        ]
      },
      "freshness": {
        "type": "object",
        "properties": {
          "contentVersion": {
            "type": [
              "string",
              "number",
              "null"
            ]
          },
          "updatedAt": {
            "type": [
              "string",
              "null"
            ]
          }
        },
