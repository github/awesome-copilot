  },
  "keywords": [
    "decrypt-pdf",
    "document-tools",
    "ghostscript",
    "pdf",
    "pdf-password",
    "pdf-permissions",
    "print-to-pdf",
    "quartz",
    "unlock-pdf"
  ],
  "dependencies": {
    "@github/copilot-sdk": "latest"
  }
}
