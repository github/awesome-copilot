  "version": "1.0.0",
  "author": {
    "name": "David Kaya",
    "url": "https://github.com/davidkaya"
  },
  "repository": "https://github.com/github/awesome-copilot",
  "license": "MIT",
  "keywords": [
    "ai-credits",
    "canvas",
    "copilot-extension",
    "session-analytics",
    "token-usage",
    "usage-insights"
  ],
  "extensions": {
    "com.github.copilot": {
      "logo": "assets/preview.png"
    },
    "com.github.awesome-copilot": {
      "extensions": [
        "./extensions/usage-insights"
      ]
    }
  }
}
