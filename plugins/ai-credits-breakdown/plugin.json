  "version": "1.0.0",
  "author": {
    "name": "Roza Jiang",
    "url": "https://github.com/rozajay"
  },
  "repository": "https://github.com/github/awesome-copilot",
  "license": "MIT",
  "keywords": [
    "ai-credits",
    "canvas",
    "copilot-extension",
    "cost-tracking",
    "token-usage",
    "usage-analytics"
  ],
  "extensions": {
    "com.github.copilot": {
      "logo": "assets/preview.png"
    },
    "com.github.awesome-copilot": {
      "extensions": [
        "./extensions/ai-credits-breakdown"
      ]
    }
  }
}
